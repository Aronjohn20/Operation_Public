# ============================================================================
# CSI Operations - Environment Variables Configuration Template
# ============================================================================
#
# NOTE FOR USERS / FORKERS:
# - By default, this project runs 100% in local client-side Sandbox Mode.
# - No database or Google account is required to test and evaluate the platform.
# - If you wish to connect your own club's Supabase or Google Drive webhooks,
#   fill in the credentials below and rename this file to .env.local.
# ============================================================================

# Supabase PostgreSQL Configuration (Optional - for real-time cloud database sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Apps Script Webhooks (Optional - for real 1-click Google Drive automated forms)
# Deploy your Google Apps Script as a Web App (Access: Anyone) and paste URLs below:
NEXT_PUBLIC_CSI_GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/your-registration-webhook-id/exec
NEXT_PUBLIC_CSI_FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/your-feedback-webhook-id/exec

